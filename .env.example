NODE_ENV=production
HOST=127.0.0.1
PORT=3200
PUBLIC_BASE_URL=https://api.tutoriaiscroche.com.br
CORS_ORIGINS=https://tutoriaiscroche.com.br,https://www.tutoriaiscroche.com.br
ADMIN_API_KEY=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

YOUTUBE_API_KEY=
YOUTUBE_REGION=BR
YOUTUBE_DEFAULT_LANGUAGE=pt

SEARXNG_URL=http://127.0.0.1:8080
SEARXNG_TIMEOUT_MS=5000

MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_MASTER_KEY=
MEILISEARCH_INDEX=croche_conteudos
MEILISEARCH_TIMEOUT_MS=3000

SEARCH_CACHE_TTL_SECONDS=900
SEARCH_MAX_QUERY_LENGTH=180
SEARCH_PROVIDER_TIMEOUT_MS=6000

# Provedores externos opcionais
VALUESERP_API_KEY=
VALUESERP_BASE_URL=https://api.valueserp.com/search
VALUESERP_SEARCH_TYPE=images
VALUESERP_GOOGLE_DOMAIN=google.com.br
VALUESERP_GL=br
VALUESERP_HL=pt-br
VALUESERP_TIME_PERIOD=last_month
VALUESERP_MAX_PAGES=100
VALUESERP_TIMEOUT_MS=15000
VALUESERP_TOTAL_TIMEOUT_MS=120000

PINTEREST_BASE_URL=https://www.pinterest.com
PINTEREST_MAX_PAGES=100
# Limite seguro por requisição HTTP; continue usando pinterest_bookmark para o próximo lote.
PINTEREST_BATCH_MAX_PAGES=3
PINTEREST_TIMEOUT_MS=15000
PINTEREST_TOTAL_TIMEOUT_MS=120000
SEARCH_RATE_LIMIT_WINDOW_MS=60000
SEARCH_RATE_LIMIT_MAX=60
LOG_LEVEL=info
